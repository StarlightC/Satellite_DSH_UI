{
  "name": "satellite-ui",
  "version": "0.1.0",
  "description": "Satellite 的界面插件：在设置页里配置各角色的 provider 与 model。可选安装——功能不需要界面时不必装它。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.2 <0.3",
    "satellite": ">=0.1.0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "satellite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.8.0"
  }
}
